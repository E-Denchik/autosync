# Порты, на которых сервисы публикуются на хосте
FRONTEND_PORT=5173
BACKEND_PORT=5000
LLM_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# Postgres
POSTGRES_USER=autosync
POSTGRES_PASSWORD=autosync
POSTGRES_DB=autosync
DATABASE_URL=postgresql://autosync:autosync@postgres:5432/autosync

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Backend — подписывает JWT-токены авторизации. ОБЯЗАТЕЛЬНО заменить на
# случайную строку в проде (например: openssl rand -hex 32).
SECRET_KEY=dev-secret-change-me
JWT_EXPIRES_HOURS=168

# LLM service — какую модель реально использовать, выбирает администратор
# в UI (Настройки → LLM), выбор хранится в БД и переживает перезапуски.
# Переменные ниже — только резервный вариант по умолчанию, пока выбор ещё
# не сделан (или для прямых curl-запросов к llm-service в обход backend).
LLM_SERVICE_URL=http://llm-service:8000
OLLAMA_BASE_URL=http://ollama:11434
# LM Studio живёт на хосте (GUI-приложение), а не в Docker-контейнере — из
# контейнеров используйте host.docker.internal вместо localhost.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:14b

# Ozon Seller API / Performance API
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=

# Сторонний аналитический сервис по Ozon (MPSTATS / Moneyplace / аналог — уточнить с заказчиком)
ANALYTICS_PROVIDER_BASE_URL=
ANALYTICS_PROVIDER_API_KEY=

# API поставщика запчастей
PARTS_SUPPLIER_BASE_URL=
PARTS_SUPPLIER_API_KEY=

# Matching
MATCH_CONFIDENCE_THRESHOLD=0.75

# Frontend — адрес backend, вшивается в собранный фронтенд-бандл на этапе
# `docker compose build` (Vite инлайнит env на билде, не в рантайме).
# Если AutoSync разворачивается на сервере, доступном не только с localhost —
# укажи здесь публичный IP/домен сервера, иначе браузеры других пользователей
# не смогут достучаться до API.
VITE_API_BASE_URL=http://localhost:5000/api
