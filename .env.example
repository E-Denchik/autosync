# AutoSync — обычное desktop-приложение (native_app.py), без Docker и без
# браузерного доступа. Эти переменные не подхватываются автоматически
# (нет dotenv-загрузки) — выставляй их как обычные переменные окружения
# перед запуском, если нужно отклониться от значений по умолчанию.

# Каталог данных (БД, загрузки) и порты, на которых слушает сам процесс —
# см. backend/native_app.py: get_data_dir(). По умолчанию — ~/.autosync,
# порты 5000 (backend) и 8001 (llm-service), оба только на 127.0.0.1.
AUTOSYNC_DATA_DIR=
AUTOSYNC_PORT=5000
AUTOSYNC_LLM_PORT=8001

# Подписывает JWT-токены авторизации. ОБЯЗАТЕЛЬНО заменить на случайную
# строку (например: openssl rand -hex 32) — иначе кто угодно с исходником
# может подделать токен администратора.
SECRET_KEY=dev-secret-change-me
JWT_EXPIRES_HOURS=168

# LLM — какую модель реально использовать, выбирает администратор в UI
# (Администрирование → LLM-модель), выбор хранится в БД и переживает
# перезапуски. Переменные ниже — только адреса локальных LLM-серверов,
# которые приложение опрашивает для discovery моделей.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Ozon Seller API / Performance API. Статус подключения и тестовый запрос
# доступны в UI: Администрирование → Интеграции (без реальных ключей эндпоинт
# честно вернёт "не настроено", это ожидаемо).
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=

# Сторонний аналитический сервис по Ozon (MPSTATS / Moneyplace / аналог — уточнить с заказчиком).
# Как и Ozon API выше, статус и тест подключения — в UI (Администрирование → Интеграции).
ANALYTICS_PROVIDER_BASE_URL=
ANALYTICS_PROVIDER_API_KEY=

# API поставщика запчастей
PARTS_SUPPLIER_BASE_URL=
PARTS_SUPPLIER_API_KEY=

# Matching
MATCH_CONFIDENCE_THRESHOLD=0.75
