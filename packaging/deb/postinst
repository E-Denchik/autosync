#!/bin/bash
# postinst — деплой AutoSync после `dpkg -i autosync_*.deb`.
#
# Файлы приложения лежат в фиксированном месте (/usr/share/autosync/dist,
# так их туда положил dpkg), но реально работает AutoSync из каталога,
# который пользователь выбирает через debconf — это единственный способ
# сделать место установки настраиваемым при использовании dpkg напрямую:
# сам dpkg не умеет спрашивать "куда класть файлы", поэтому мы прячем
# исходники в системный путь и разворачиваем (копируем) их оттуда сюда.
set -e

. /usr/share/debconf/confmodule

STAGE_DIR=/usr/share/autosync/dist

db_get autosync/install-dir
INSTALL_DIR="${RET:-/opt/autosync}"

db_get autosync/public-host
PUBLIC_HOST="$RET"

db_get autosync/frontend-port
FRONTEND_PORT="${RET:-5173}"

db_get autosync/pull-llm-model
PULL_MODEL="$RET"

db_get autosync/admin-email
ADMIN_EMAIL="${RET:-admin@autosync.local}"

db_get autosync/admin-password
ADMIN_PASSWORD="$RET"

case "$1" in
  configure)
    mkdir -p "$INSTALL_DIR"

    # Не затираем существующий .env и загруженные пользователем файлы при
    # переустановке/обновлении пакета.
    rsync -a --exclude='.env' --exclude='uploads/' "$STAGE_DIR"/ "$INSTALL_DIR"/

    if [ -z "$PUBLIC_HOST" ]; then
      PUBLIC_HOST="$(hostname -I 2>/dev/null | awk '{print $1}')"
      [ -z "$PUBLIC_HOST" ] && PUBLIC_HOST="localhost"
    fi

    if [ ! -f "$INSTALL_DIR/.env" ]; then
      cp "$INSTALL_DIR/.env.example" "$INSTALL_DIR/.env"
      GENERATED_SECRET="$(head -c32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
      sed -i "s#^SECRET_KEY=.*#SECRET_KEY=${GENERATED_SECRET}#" "$INSTALL_DIR/.env"
      sed -i "s#^FRONTEND_PORT=.*#FRONTEND_PORT=${FRONTEND_PORT}#" "$INSTALL_DIR/.env"
      sed -i "s#^VITE_API_BASE_URL=.*#VITE_API_BASE_URL=http://${PUBLIC_HOST}:5000/api#" "$INSTALL_DIR/.env"
      echo "AutoSync: создан $INSTALL_DIR/.env (порты/URL по умолчанию — отредактируйте при необходимости)."
    else
      echo "AutoSync: найден существующий $INSTALL_DIR/.env — оставляю как есть."
    fi

    mkdir -p "$INSTALL_DIR/uploads"

    sed "s#{{INSTALL_DIR}}#${INSTALL_DIR}#g" /usr/share/autosync/autosync.service.template \
      > /etc/systemd/system/autosync.service
    systemctl daemon-reload || true
    systemctl enable autosync.service >/dev/null 2>&1 || true

    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
      echo "AutoSync: собираю и запускаю контейнеры — это может занять несколько минут…"
      if (cd "$INSTALL_DIR" && docker compose up -d --build); then

        # Ждём, пока backend поднимется и применит миграции, прежде чем
        # заводить администратора.
        for i in $(seq 1 30); do
          (cd "$INSTALL_DIR" && docker compose exec -T backend true) >/dev/null 2>&1 && break
          sleep 2
        done

        if [ -z "$ADMIN_PASSWORD" ]; then
          ADMIN_PASSWORD="$(head -c16 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c16)"
          {
            echo "email=${ADMIN_EMAIL}"
            echo "password=${ADMIN_PASSWORD}"
          } > "$INSTALL_DIR/INITIAL_ADMIN_CREDENTIALS.txt"
          chmod 600 "$INSTALL_DIR/INITIAL_ADMIN_CREDENTIALS.txt"
        fi

        (cd "$INSTALL_DIR" && docker compose exec -T backend \
          flask users create-admin --email "$ADMIN_EMAIL" --password "$ADMIN_PASSWORD") \
          || echo "AutoSync: не удалось создать администратора автоматически — сделайте это вручную: docker compose exec backend flask users create-admin --email ... --password ..."

        if [ "$PULL_MODEL" = "true" ]; then
          echo "AutoSync: загружаю LLM-модель qwen2.5:14b (может занять долгое время)…"
          (cd "$INSTALL_DIR" && docker compose exec -T ollama ollama pull qwen2.5:14b) \
            || echo "AutoSync: не удалось скачать модель автоматически — выполните позже: docker compose exec ollama ollama pull qwen2.5:14b"
        fi

        echo ""
        echo "============================================================"
        echo " AutoSync установлен и запущен."
        echo " Открыть в браузере: http://${PUBLIC_HOST}:${FRONTEND_PORT}/"
        echo " Логин администратора: ${ADMIN_EMAIL}"
        if [ -f "$INSTALL_DIR/INITIAL_ADMIN_CREDENTIALS.txt" ]; then
          echo " Пароль сгенерирован и сохранён в:"
          echo "   $INSTALL_DIR/INITIAL_ADMIN_CREDENTIALS.txt"
        fi
        echo " Каталог установки: $INSTALL_DIR"
        echo "============================================================"
      else
        echo ""
        echo "AutoSync: docker compose up завершился с ошибкой — см. вывод выше."
        echo "Повторить запуск можно командой: systemctl start autosync"
      fi
    else
      echo ""
      echo "============================================================"
      echo " Docker / Docker Compose plugin не найдены в системе."
      echo " Установите их, например:"
      echo "   apt-get install -y docker.io docker-compose-v2"
      echo " и затем выполните:"
      echo "   systemctl start autosync"
      echo ""
      echo " Файлы AutoSync уже развёрнуты в: $INSTALL_DIR"
      echo "============================================================"
    fi
    ;;
esac

db_stop
exit 0
