#!/bin/bash
# postrm — остановка AutoSync при удалении пакета. Данные (Postgres,
# загруженные документы) по умолчанию НЕ удаляются на `apt remove` — только
# на `apt purge`, и то с явным подтверждением ниже.
set -e

. /usr/share/debconf/confmodule || true

case "$1" in
  remove)
    systemctl stop autosync.service >/dev/null 2>&1 || true
    systemctl disable autosync.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/autosync.service
    systemctl daemon-reload >/dev/null 2>&1 || true

    echo "AutoSync остановлен. Файлы приложения и Docker-volume с данными НЕ удалены."
    echo "Чтобы удалить всё безвозвратно (включая базу данных): apt purge autosync"
    ;;

  purge)
    db_get autosync/install-dir 2>/dev/null || true
    INSTALL_DIR="${RET:-/opt/autosync}"

    if [ -d "$INSTALL_DIR" ] && [ -f "$INSTALL_DIR/docker-compose.yml" ]; then
      (cd "$INSTALL_DIR" && docker compose down -v) >/dev/null 2>&1 || true
    fi

    db_purge || true
    ;;
esac

exit 0
