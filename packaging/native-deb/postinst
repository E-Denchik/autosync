#!/bin/sh
# Никаких debconf-диалогов и Docker — установка сводится к правам на
# бинарник и регистрации в меню приложений.
set -e

chmod 0755 /opt/autosync/autosync

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

echo ""
echo "AutoSync установлен. Запустите его из меню приложений, либо командой:"
echo "  /opt/autosync/autosync"
echo "Откроется собственное окно приложения — сразу готово к работе."

exit 0
